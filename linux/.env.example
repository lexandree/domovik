# Local web app
PORT=3000

# Main text backend for text-only turns: vision_provider or minimax.
# Use minimax if you want plain text requests to stay up even when the vision backend is down.
TEXT_PROVIDER=minimax

# Main screenshot-aware vision flow
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: screenshot-aware vision backend
VISION_BASE_URL=https://your-cloudflare-host.example.com/v1
VISION_API_KEY=EMPTY
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_MAX_IMAGES=1
TAVILY_API_KEY=
AGENTIC_MAX_CYCLES=3
AGENTIC_RUNTIME_SECONDS=15
SEARCH_HTTP_TIMEOUT_SECONDS=12
VISUAL_AUGMENTATION_PROVIDERS=

# Optional: Cloudflare Access service token headers for the vision backend
VISION_CF_ACCESS_CLIENT_ID=
VISION_CF_ACCESS_CLIENT_SECRET=

# ElevenLabs voice + optional STT
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_KEYTERMS=Codex,Claude Code,OpenClaw,screenshot,скриншот,bildschirm

# Text-to-speech provider: elevenlabs or minimax
TTS_PROVIDER=elevenlabs

# Optional: MiniMax TTS
MINIMAX_API_KEY=
MINIMAX_TEXT_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=
MINIMAX_VOICE_SPEED=1
MINIMAX_VOICE_VOLUME=1
MINIMAX_VOICE_PITCH=0
MINIMAX_AUDIO_SAMPLE_RATE=32000
MINIMAX_AUDIO_BITRATE=128000

# Speech-to-text provider: sherpa_onnx is the recommended native-shell path.
# Use elevenlabs or whisper if you need browser MediaRecorder transcription too.
STT_PROVIDER=sherpa_onnx

# Optional: local Whisper fallback
WHISPER_PYTHON=python3
WHISPER_MODEL=base
WHISPER_LANGUAGE=de

# Optional: sherpa-onnx offline websocket server
SHERPA_ONNX_SERVER_ADDR=127.0.0.1
SHERPA_ONNX_SERVER_PORT=6006
SHERPA_ONNX_SAMPLE_RATE=16000
SHERPA_ONNX_CHUNK_BYTES=10240
SHERPA_ONNX_TIMEOUT_SECONDS=30

# Optional: local one-shot handoffs
CODEX_COMMAND=codex
CLAUDE_CODE_COMMAND=claude
CODEX_WORKDIR=../playground
CODEX_TIMEOUT_SECONDS=900

OPENCLAW_COMMAND=openclaw
OPENCLAW_SESSION_KEY=main
OPENCLAW_TIMEOUT_SECONDS=900
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
GATEWAY_TOKEN=dein_token
